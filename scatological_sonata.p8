pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- the scatological sonata
-- prototipo base

spr_p_idle=5
spr_p_walk1=21
spr_p_walk2=37

spr_c1=33
spr_c1_idle=1
spr_c1_walk=17
spr_c2=34
spr_c2_idle=2
spr_c2_walk=18

spr_drop_fast=4
spr_drop_heart=6
spr_drop_heart2=22
spr_note=7

spr_candle=66
spr_candle_l=82
spr_candle_r=98

spr_win_icon=4
spr_lose_icon=9

sfx_poop_die=6
sfx_x=7

player={}
bullets={}
enemies={}
drops={}
lit_candles={}

kills=0
kills_to_win=25
game_state="title"

spawn_timer=0
spawn_rate=35
max_enemies=5

hud_h=10

function _init()
 palt(0,true)
 init_level()
 game_state="title"
 music(2)
end

function play_menu_music()
 music(2)
end

function play_level_music()
 music(0)
end

function stop_music()
 music(-1)
end

function play_poop_sfx()
 sfx(sfx_poop_die,3)
end

function play_x_sfx()
 sfx(sfx_x,3)
end

function init_level()
 player={
  x=56,
  y=56,
  w=8,
  h=8,
  spd=1.2,
  lives=3,
  aimx=0,
  aimy=-1,
  shoot_cd=0,
  shoot_rate=10,
  inv=0,
  rapid_timer=0,
  moving=false
 }

 bullets={}
 enemies={}
 drops={}
 lit_candles={}
 kills=0
 spawn_timer=0

 init_decor()
end

function init_decor()
 add(lit_candles,{tx=3,ty=5})
 add(lit_candles,{tx=6,ty=2})
 add(lit_candles,{tx=2,ty=10})
 add(lit_candles,{tx=13,ty=7})
 add(lit_candles,{tx=10,ty=11})
end

function _update()
 if game_state=="title" then
  if btnp(5) then
   play_x_sfx()
   init_level()
   game_state="play"
   play_level_music()
  end
  return
 end

 if game_state=="pause" then
  if btnp(5) then
   play_x_sfx()
   game_state="play"
   play_level_music()
  end
  return
 end

 if game_state=="dead" then
  if btnp(5) then
   play_x_sfx()
   game_state="title"
   play_menu_music()
  end
  return
 end

 if game_state=="win" then
  if btnp(5) then
   play_x_sfx()
   game_state="title"
   play_menu_music()
  end
  return
 end

 if btnp(5) then
  play_x_sfx()
  game_state="pause"
  stop_music()
  return
 end

 update_player()
 update_bullets()
 update_enemies()
 update_drops()
 spawn_wave()
 check_bullet_enemy_collisions()
 check_enemy_player_collisions()
 check_drop_player_collisions()

 if kills>=kills_to_win then
  game_state="win"
  play_menu_music()
 end
end

function _draw()
 cls(0)

 if game_state=="title" then
  draw_title_screen()
  return
 end

 draw_arena()
 draw_drops()
 draw_bullets()
 draw_enemies()
 draw_player()
 draw_hud()

 if game_state=="pause" then
  draw_pause_screen()
 end

 if game_state=="dead" then
  draw_lose_screen()
 end

 if game_state=="win" then
  draw_win_screen()
 end
end

function update_player()
 local dx=0
 local dy=0

 if btn(0) then dx=-1 end
 if btn(1) then dx=1 end
 if btn(2) then dy=-1 end
 if btn(3) then dy=1 end

 player.moving=(dx!=0 or dy!=0) and not btn(4)

 if player.shoot_cd>0 then
  player.shoot_cd-=1
 end

 if player.inv>0 then
  player.inv-=1
 end

 if player.rapid_timer>0 then
  player.rapid_timer-=1
  player.shoot_rate=2
 else
  player.shoot_rate=10
 end

 if btn(4) then
  if dx!=0 or dy!=0 then
   player.aimx=dx
   player.aimy=dy
  end

  if player.shoot_cd<=0 then
   shoot_bullet(player.x+4,player.y+4,player.aimx,player.aimy)
   player.shoot_cd=player.shoot_rate
  end
 else
  player.x+=dx*player.spd
  player.y+=dy*player.spd
 end

 player.x=mid(4,player.x,116)
 player.y=mid(hud_h+4,player.y,116)
end

function shoot_bullet(x,y,dx,dy)
 if dx==0 and dy==0 then
  dx=0
  dy=-1
 end

 add(bullets,{
  x=x,
  y=y,
  dx=dx,
  dy=dy,
  spd=3
 })
end

function update_bullets()
 for b in all(bullets) do
  b.x+=b.dx*b.spd
  b.y+=b.dy*b.spd

  if b.x<-8 or b.x>136 or b.y<-8 or b.y>136 then
   del(bullets,b)
  end
 end
end

function spawn_wave()
 spawn_timer+=1

 if spawn_timer>=spawn_rate then
  spawn_timer=0

  if #enemies<max_enemies and kills<kills_to_win then
   spawn_enemy()
  end
 end
end

function spawn_enemy()
 local side=flr(rnd(4))
 local ex=0
 local ey=0
 local enemy_kind=1

 if rnd(1)<0.5 then
  enemy_kind=2
 end

 if side==0 then
  ex=-8
  ey=flr(rnd(121))
 elseif side==1 then
  ex=128
  ey=flr(rnd(121))
 elseif side==2 then
  ex=flr(rnd(121))
  ey=-8
 else
  ex=flr(rnd(121))
  ey=128
 end

 if ey<hud_h then
  ey=hud_h
 end

 add(enemies,{
  x=ex,
  y=ey,
  w=8,
  h=8,
  spd=0.65+rnd(0.35),
  kind=enemy_kind
 })
end

function update_enemies()
 for e in all(enemies) do
  local dx=(player.x-e.x)
  local dy=(player.y-e.y)
  local dist=sqrt(dx*dx+dy*dy)

  if dist>0 then
   e.x+=dx/dist*e.spd
   e.y+=dy/dist*e.spd
  end
 end
end

function update_drops()
 for d in all(drops) do
  d.t-=1
  if d.t<=0 then
   del(drops,d)
  end
 end
end

function check_bullet_enemy_collisions()
 for b in all(bullets) do
  for e in all(enemies) do
   if overlap(b.x-2,b.y-2,4,4,e.x,e.y,e.w,e.h) then
    spawn_drop(e.x,e.y)
    del(enemies,e)
    del(bullets,b)
    kills+=1
    play_poop_sfx()
    break
   end
  end
 end
end

function spawn_drop(x,y)
 local r=rnd(1)

 if r<0.08 then
  add(drops,{
   x=x,
   y=y,
   w=8,
   h=8,
   kind="fast",
   spr=spr_drop_fast,
   t=300
  })
 elseif r<0.12 then
  add(drops,{
   x=x,
   y=y,
   w=8,
   h=8,
   kind="heart",
   spr=spr_drop_heart,
   t=300
  })
 end
end

function check_enemy_player_collisions()
 if player.inv>0 then
  return
 end

 for e in all(enemies) do
  if overlap(player.x,player.y,player.w,player.h,e.x,e.y,e.w,e.h) then
   del(enemies,e)
   player.lives-=1
   player.inv=60

   if player.lives<=0 then
    game_state="dead"
    stop_music()
   end
   break
  end
 end
end

function check_drop_player_collisions()
 for d in all(drops) do
  if overlap(player.x,player.y,player.w,player.h,d.x,d.y,d.w,d.h) then
   if d.kind=="fast" then
    player.rapid_timer=180
   elseif d.kind=="heart" then
    player.lives=min(player.lives+1,5)
   end

   del(drops,d)
   break
  end
 end
end

function overlap(x1,y1,w1,h1,x2,y2,w2,h2)
 return x1<x2+w2 and
        x1+w1>x2 and
        y1<y2+h2 and
        y1+h1>y2
end

function draw_arena()
 rectfill(0,hud_h,127,127,0)

 map(0,0,0,hud_h,16,16)

 draw_lit_candles()

 rect(0,hud_h,127,127,5)
 rect(1,hud_h+1,126,126,5)
 line(0,hud_h-1,127,hud_h-1,5)
end

function draw_lit_candles()
 local frame=flr(time()*3)%4

 for c in all(lit_candles) do
  local spr_id=spr_candle

  if frame==0 then
   spr_id=spr_candle
  elseif frame==1 then
   spr_id=spr_candle_l
  elseif frame==2 then
   spr_id=spr_candle
  else
   spr_id=spr_candle_r
  end

  spr(spr_id,c.tx*8,hud_h+c.ty*8)
 end
end

function draw_player()
 if player.inv>0 and flr(player.inv/4)%2==0 then
  return
 end

 local spr_id=spr_p_idle

 if player.moving then
  if flr(time()*8)%2==0 then
   spr_id=spr_p_walk1
  else
   spr_id=spr_p_walk2
  end
 end

 spr(spr_id,player.x,player.y)
end

function draw_bullets()
 for b in all(bullets) do
  spr(spr_note,b.x-4,b.y-4)
 end
end

function draw_enemies()
 for e in all(enemies) do
  local spr_id=spr_c1

  if e.kind==1 then
   if flr(time()*8)%2==0 then
    spr_id=spr_c1
   else
    spr_id=spr_c1_walk
   end
  else
   if flr(time()*8)%2==0 then
    spr_id=spr_c2
   else
    spr_id=spr_c2_walk
   end
  end

  spr(spr_id,e.x,e.y)
 end
end

function draw_drops()
 for d in all(drops) do
  if d.t<60 and flr(time()*8)%2==0 then
   -- blink al final
  else
   local spr_id=d.spr

   if d.kind=="heart" then
    if flr(time()*6)%2==0 then
     spr_id=spr_drop_heart
    else
     spr_id=spr_drop_heart2
    end
   end

   spr(spr_id,d.x,d.y)
  end
 end
end

function draw_hud()
 rectfill(0,0,127,hud_h-1,0)

 for i=1,player.lives do
  spr(spr_drop_heart,(i-1)*8,1)
 end

 print(kills.."/"..kills_to_win,96,2,7)
end

function cprint(txt,y,col)
 local x=64-(#txt*4)/2
 print(txt,x,y,col)
end

function big_cprint(txt,y,col,shadow_col)
 local x=64-(#txt*4)/2

 print(txt,x-1,y,shadow_col)
 print(txt,x+1,y,shadow_col)
 print(txt,x,y-1,shadow_col)
 print(txt,x,y+1,shadow_col)
 print(txt,x,y,col)
end

function draw_title_border()
 rect(1,1,126,126,4)
 rect(3,3,124,124,4)

 line(10,3,18,3,4)
 line(109,3,117,3,4)
 line(10,124,18,124,4)
 line(109,124,117,124,4)

 line(3,10,3,18,4)
 line(124,10,124,18,4)
 line(3,109,3,117,4)
 line(124,109,124,117,4)

 pset(8,8,4)
 pset(119,8,4)
 pset(8,119,4)
 pset(119,119,4)
end

function draw_title_screen()
 cls(15)

 draw_title_border()

 spr(spr_p_idle,18,24)
 spr(spr_c1_idle,98,22)
 spr(spr_c2_idle,106,34)

 big_cprint("the scatological",20,7,4)
 big_cprint("sonata",34,9,4)

 cprint("controls",62,3)
 cprint("arrows: move",74,9)
 cprint("z: shoot",84,9)

 if flr(time()*2)%2==0 then
  cprint("press x to start",108,11)
 end
end

function draw_pause_screen()
 rectfill(18,42,109,86,0)
 rectfill(20,44,107,84,1)
 rect(20,44,107,84,7)

 cprint("pause",52,7)
 cprint("press x to resume",66,6)
 cprint("press z to shoot",76,13)
end

function draw_win_screen()
 rectfill(10,32,117,95,1)
 rectfill(12,34,115,93,3)
 rect(12,34,115,93,7)
 rect(10,32,117,95,11)

 spr(spr_win_icon,58,42)

 cprint("you win!",58,7)
 cprint("you are a music",70,11)
 cprint("genius!",80,11)

 cprint("press x for title",102,7)
end

function draw_lose_screen()
 rectfill(10,32,117,95,4)
 rectfill(12,34,115,93,9)
 rect(12,34,115,93,4)
 rect(10,32,117,95,0)

 spr(spr_lose_icon,58,42)

 cprint("you lost",58,0)
 cprint("you love poop",74,4)

 cprint("press x for title",102,7)
end
